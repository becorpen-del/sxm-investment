			<script>jQuery(document).ready(function($) {
    // Retirer TOUS les événements du thème sur les filtres
    $('.status-cls, .type-cls, .location-cls').off();
    
    // Ajouter notre propre événement
    setTimeout(function() {
        $('.status-cls').on('change', function() {
            var value = $(this).val();
            if (value) {
                window.location.href = window.location.pathname + '?budget=' + value;
            }
        });
        
        $('.type-cls').on('change', function() {
            var value = $(this).val();
            if (value) {
                window.location.href = window.location.pathname + '?type=' + value;
            }
        });
        
        $('.location-cls').on('change', function() {
            var value = $(this).val();
            if (value) {
                window.location.href = window.location.pathname + '?location=' + value;
            }
        });
    }, 100);
});</script><script>document.addEventListener('DOMContentLoaded', function() {
    const selects = document.querySelectorAll('select');
    
    selects.forEach(select => {
        const options = Array.from(select.options);
        
        // Trouve le select budget (vérifie si les options contiennent "$")
        if (options.some(opt => opt.text.includes('$') && opt.text.includes('000'))) {
            const first = options.shift(); // Garde "Budget" (premier élément)
            
            // Trie par le premier nombre
            options.sort((a, b) => {
                const getFirstNumber = (text) => {
                    const match = text.match(/(\d[\d\s]*)/);
                    return match ? parseInt(match[0].replace(/\s/g, '')) : 0;
                };
                return getFirstNumber(a.text) - getFirstNumber(b.text);
            });
            
            // Reconstruit le select
            select.innerHTML = '';
            select.add(first);
            options.forEach(opt => select.add(opt));
        }
    });
});</script>
