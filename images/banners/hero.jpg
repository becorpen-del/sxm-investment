                                                        <style>/* === Remove bullet points and spacing from the Useful Links menu === */
.menu-useful-links-container ul {
    list-style: none;       /* Removes the default bullets */
    padding-left: 0;        /* Removes left padding (indent) */
    margin-left: 0;         /* Removes left margin (extra spacing) */
}

/* Hide ::marker explicitly in case some browsers still show it */
.menu-useful-links-container ul li::marker {
    display: none;
}

/* === Style only the <h5> headings inside Elementor widget containers === */
/* This affects: Contact, Useful Links, Newsletter headings */
/* Does NOT affect other <h5> tags elsewhere on the site */
.site-footer .elementor-widget-container h5 {
    color: white;              /* Makes the heading text white */
    text-transform: uppercase; /* Converts text to ALL CAPS */
}
</style>
                                                        <style>.custom-gallery-grid {
    display: flex;
    flex-wrap: nowrap;
    gap: 10px;
}
.left-big {
    width: 50%;
    height: 600px; /* Fixed height for the left big image */
}
.left-big img,
.left-big video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 8px;
}
.right-grid {
    width: 50%;
    height: 600px; /* Match the left-big height */
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 10px;
}
.grid-gallery-item {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
}
.grid-gallery-item img,
.grid-gallery-item video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 8px;
}
.see-all-btn {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: var(--e-global-color-accent);
    color: #fff;
    text-align: center;
    padding: 10px;
    font-weight: 500;
    cursor: pointer;
    z-index: 2;
    border-radius: 0 0 8px 8px;
}
@media (max-width: 600px) {
  .custom-gallery-grid {
    flex-wrap: wrap;
  }
  
  .left-big,
  .right-grid {
    width: 100%;
    height: auto; /* Remove fixed height on mobile */
  }
  
  .left-big img,
  .left-big video {
    height: auto;
    aspect-ratio: 4 / 3;
  }
  
  .right-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: auto auto;
    gap: 10px;
  }
  
  .grid-gallery-item {
    height: auto;
  }
  
  .grid-gallery-item img,
  .grid-gallery-item video {
    aspect-ratio: 1 / 1;
    height: auto;
  }
}
.fancybox__container {
    z-index: 99999 !important;
}</style>
